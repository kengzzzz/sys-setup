 }
 
+// Some templates accept the system role only for the first message. Responses
+// clients may add developer instructions later in a replay; after mapping the
+// developer role to system, merge those instructions into one leading message.
+static void system_message_must_be_first(json & messages) {
+    json system_message;
+    json reordered = json::array();
+
+    auto append_content = [](json & destination, const json & source) {
+        if (destination.is_string() && source.is_string()) {
+            destination = destination.get<std::string>() + "\n\n" + source.get<std::string>();
+            return;
+        }
+
+        json parts = json::array();
+        auto append_parts = [&parts](const json & content) {
+            if (content.is_string()) {
+                parts.push_back({
+                    { "type", "text"                       },
+                    { "text", content.get<std::string>() },
+                });
+            } else if (content.is_array()) {
+                parts.insert(parts.end(), content.begin(), content.end());
+            }
+        };
+        append_parts(destination);
+        append_parts(source);
+        destination = std::move(parts);
+    };
+
+    for (auto & message : messages) {
+        if (message.value("role", "") != "system") {
+            reordered.push_back(std::move(message));
+            continue;
+        }
+
+        if (system_message.is_null()) {
+            system_message = std::move(message);
+        } else {
+            append_content(system_message["content"], message.at("content"));
+        }
+    }
+
+    if (!system_message.is_null()) {
+        reordered.insert(reordered.begin(), std::move(system_message));
+    }
+    messages = std::move(reordered);
+}
+
 
