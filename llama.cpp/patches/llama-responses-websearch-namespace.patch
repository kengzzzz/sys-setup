 #include <sstream>
 
+static const std::string WEBSEARCH_NAMESPACE = "mcp__websearch";
+static const std::string WEBSEARCH_TOOL_PREFIX = "llama_websearch__";
+
+static std::string server_chat_encode_websearch_tool_name(const std::string & tool_name) {
+    return WEBSEARCH_TOOL_PREFIX + tool_name;
+}
+
+bool server_chat_decode_websearch_tool_name(const std::string & encoded_name, std::string & tool_name) {
+    if (encoded_name.rfind(WEBSEARCH_TOOL_PREFIX, 0) != 0) {
+        return false;
+    }
+
+    tool_name = encoded_name.substr(WEBSEARCH_TOOL_PREFIX.size());
+    return !tool_name.empty();
+}
